# Godot 4+ specific ignores
.godot/
.godot/imported/
.godot/mono/
.godot/shader_cache/

# General ignores
*.o
*.rrev
*.so
*.a
*.pyc
*.pyo
*.pyd
*.swp
*~
.#*

# Godot-specific asset dump files
.godot/editor/remotescan.*
.godot/editor/godot_system_info_*

# Exported binaries
/export/
/export_presets.cfg
*.export/
*.pck
*.exe
*.dmg
*.app
*.apk
*.aab

# Mono/C#
.mono/
/bin/
/obj/
*.csproj.user
*.sln.DotSettings.user
*.suo

# User-specific settings
.editor/
.vscode/
.idea/

# Asset files that should be imported
# If you want to store the imported files in git, comment out the line below.
*.import

# Logs and cache
/logs/
/cache/
/user_data/

# OS-specific
.DS_Store
Thumbs.db
